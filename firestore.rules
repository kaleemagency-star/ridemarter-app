rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && 
        request.auth.token.email.lower() == 'kaleemagency@gmail.com';
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Config collection (pricing plans, UPI details, support info)
    match /config/{configId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Users collection (users/{firebaseAuthUid})
    match /users/{userId} {
      // Drivers can read only their own profile; Admin can read and list all profiles
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();

      // Drivers can create their own document on registration with their matching UID
      allow create: if (isOwner(userId) && request.resource.data.uid == request.auth.uid) || isAdmin();

      // Drivers can update their own user document; Admin can update any document (activate/revoke plans)
      allow update: if (isOwner(userId) && request.resource.data.uid == request.auth.uid) || isAdmin();

      // Only Admin can delete user accounts
      allow delete: if isAdmin();
    }

    // Payments collection (payments/{automaticDocumentId})
    match /payments/{paymentId} {
      // Drivers can read their own submitted payment; Admin can read and list all payments
      allow get: if (isAuthenticated() && resource.data.uid == request.auth.uid) || isAdmin();
      allow list: if isAdmin();

      // Drivers can create payment documents only for their own UID
      allow create: if (isAuthenticated() && request.resource.data.uid == request.auth.uid) || isAdmin();

      // Only admin can approve, reject, or modify payment status
      allow update, delete: if isAdmin();
    }
  }
}
